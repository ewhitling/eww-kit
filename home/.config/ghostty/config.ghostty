# Ghostty settings. Linked into ~/.config/ghostty by eww install.
# Reload inside Ghostty with cmd+shift+comma.

# Strata, following the system appearance. The theme files sit in themes/.
theme = light:strata-paper,dark:strata-night

# A steady block cursor. Shell integration would otherwise switch it to a
# blinking bar at the prompt, so its cursor feature is turned off.
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Escape pressed with all four modifiers held sends a plain Escape. A Caps Lock
# key remapped to "hyper when held, Escape when tapped" sends Escape that way,
# and programs would otherwise receive a long key code and print part of it.
keybind = ctrl+alt+shift+super+escape=text:\x1b
