#!/bin/sh
# Leak check for a public repo. Installed by eww install on machines that
# have ~/.config/eww/denylist.txt. It refuses the commit when it finds:
#   1. a secret, as detected by gitleaks
#   2. any string from the denylist (one per line, matched without case)
# It fails closed: a missing tool or denylist refuses the commit.
set -eu

DENYLIST=${EWW_DENYLIST:-$HOME/.config/eww/denylist.txt}

refuse() {
  printf '✗ leak check: %s\n' "$1" >&2
  exit 1
}

command -v gitleaks >/dev/null 2>&1 || refuse "gitleaks is not installed"
[ -f "$DENYLIST" ] || refuse "denylist not found at $DENYLIST"

gitleaks git --pre-commit --staged --no-banner --redact >&2 || refuse "gitleaks found a secret in the staged changes"

# Blank lines and comment lines in the denylist are ignored.
patterns=$(mktemp)
trap 'rm -f "$patterns"' EXIT
grep -v -e '^[[:space:]]*$' -e '^#' "$DENYLIST" >"$patterns" || true

if [ -s "$patterns" ]; then
  added=$(git diff --cached --unified=0 --no-color | grep '^+' | grep -v '^+++' || true)
  names=$(git diff --cached --name-only)
  hits=$(printf '%s\n%s\n' "$added" "$names" | grep -i -F -o -f "$patterns" | sort -u || true)
  if [ -n "$hits" ]; then
    printf '✗ leak check: the staged changes contain denylisted text:\n' >&2
    printf '%s\n' "$hits" | sed 's/^/    /' >&2
    exit 1
  fi
fi
