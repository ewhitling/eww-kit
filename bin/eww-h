#!/bin/sh
# eww: work | Open a herdr workspace: agent on the left, context on the right.
# shellcheck disable=SC2088  # "~" appears in messages for the reader. It is not meant to expand.
set -eu

case ${1:-} in
  -h | --help)
    cat <<'HELP'
eww h [TARGET]      (alias: eww w)
eww h stop

Open a herdr workspace for a project. The left pane starts the agent.
The right pane shows `eww context`, then stays a shell.

With no TARGET:
  inside a git repo   open that repo
  anywhere else       show a picker

TARGET is one of:
  vault               the notes vault named in ~/.config/eww/vault
  NAME                a repo folder in ~/Developer, or a folder in the
                      vault's projects/

Running it again for the same project focuses the existing workspace.
`eww h stop` stops the herdr server.

Settings:
  EWW_AGENT       agent to start: claude (default), pi, or any kind herdr supports
  EWW_REPOS_DIR   where repos live (default: ~/Developer)
HELP
    exit 0
    ;;
esac

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
REPO=$(cd "$(dirname "$self")/.." && pwd -P)

EWW_HOME=${EWW_HOME:-$HOME}
CONFIG=$EWW_HOME/.config/eww
REPOS_DIR=${EWW_REPOS_DIR:-$EWW_HOME/Developer}
AGENT=${EWW_AGENT:-claude}
TAB=$(printf '\t')

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ -z "${EWW_NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
  green=$(printf '\033[32m') yellow=$(printf '\033[33m') red=$(printf '\033[31m')
  accent=$(printf '\033[34m') reset=$(printf '\033[0m')
else
  green='' yellow='' red='' accent='' reset=''
fi
ok() { printf '%s✓%s %s\n' "$green" "$reset" "$1"; }
step() { printf '%s→%s %s\n' "$accent" "$reset" "$1"; }
warn() { printf '%s!%s %s\n' "$yellow" "$reset" "$1" >&2; }
fail() {
  printf '%s✗%s eww h: %s\n' "$red" "$reset" "$1" >&2
  exit 1
}

# The vault path for this machine, or nothing when ~/.config/eww/vault is absent.
vault_path() {
  [ -f "$CONFIG/vault" ] || return 0
  vault=$(head -n 1 "$CONFIG/vault")
  case $vault in
    "~/"*) vault=$EWW_HOME/${vault#"~/"} ;;
  esac
  printf '%s\n' "$vault"
}
VAULT=$(vault_path)

# Every place a workspace can open, one per line: "label<TAB>folder".
candidates() {
  if [ -n "$VAULT" ] && [ -d "$VAULT" ]; then
    printf 'vault    %s%s%s\n' "${VAULT##*/}" "$TAB" "$VAULT"
  fi
  for dir in "$REPOS_DIR"/*/; do
    [ -e "${dir}.git" ] || continue
    dir=${dir%/}
    printf 'repo     %s%s%s\n' "${dir##*/}" "$TAB" "$dir"
  done
  if [ -n "$VAULT" ] && [ -d "$VAULT/projects" ]; then
    for dir in "$VAULT"/projects/*/; do
      [ -d "$dir" ] || continue
      dir=${dir%/}
      printf 'project  %s%s%s\n' "${dir##*/}" "$TAB" "$dir"
    done
  fi
}

# Print the folder for a name. Repos are matched before vault projects.
resolve_name() {
  if [ "$1" = vault ]; then
    printf '%s\n' "$VAULT"
    return 0
  fi
  candidates | while IFS="$TAB" read -r label dir; do
    case $label in vault*) continue ;; esac
    if [ "${dir##*/}" = "$1" ]; then
      printf '%s\n' "$dir"
      break
    fi
  done
}

# Numbered picker, used when fzf is not installed. Reads "label<TAB>folder" lines.
numbered_select() {
  menu=$(mktemp)
  cat >"$menu"
  number=0
  while IFS="$TAB" read -r label _; do
    number=$((number + 1))
    printf '%3d) %s\n' "$number" "$label" >&2
  done <"$menu"
  printf 'Select [1-%d, q to cancel]: ' "$number" >&2
  # The choice is read from the terminal, because stdin is the menu.
  read -r choice </dev/tty || choice=q
  case $choice in
    '' | q | Q | *[!0-9]*) rm -f "$menu"; return 1 ;;
  esac
  if [ "$choice" -lt 1 ] || [ "$choice" -gt "$number" ]; then
    rm -f "$menu"
    return 1
  fi
  sed -n "${choice}p" "$menu"
  rm -f "$menu"
}

# Show the picker and print the chosen folder. Returns 1 when cancelled.
pick() {
  list=$(candidates)
  [ -n "$list" ] || fail "nothing to open: no repos in $REPOS_DIR and no vault configured"
  if command -v fzf >/dev/null 2>&1; then
    line=$(printf '%s\n' "$list" | fzf --delimiter="$TAB" --with-nth=1 --prompt='eww h> ' --height=40% --reverse) || return 1
  else
    line=$(printf '%s\n' "$list" | numbered_select) || return 1
  fi
  [ -n "$line" ] || return 1
  printf '%s\n' "${line#*"$TAB"}"
}

# Decide which folder to open from the argument, the current folder, or the picker.
target_dir() {
  if [ -n "${1:-}" ]; then
    if [ "$1" = vault ] && [ -z "$VAULT" ]; then
      fail "no vault on this machine: ~/.config/eww/vault is missing"
    fi
    dir=$(resolve_name "$1")
    [ -n "$dir" ] || fail "\"$1\" is not a repo in $REPOS_DIR or a project in the vault. Run eww h for the picker."
    printf '%s\n' "$dir"
  elif dir=$(git rev-parse --show-toplevel 2>/dev/null); then
    printf '%s\n' "$dir"
  else
    pick || exit 0
  fi
}

server_running() { herdr status server 2>/dev/null | grep -q '^status: running'; }

require_herdr() {
  command -v herdr >/dev/null 2>&1 || fail "herdr is not installed"
  command -v jq >/dev/null 2>&1 || fail "jq is not installed"
}

# Start the herdr server when it is not running, and wait for it.
ensure_server() {
  server_running && return 0
  step "starting the herdr server"
  (herdr server </dev/null >/dev/null 2>&1 &)
  tries=0
  while [ "$tries" -lt 25 ]; do
    server_running && return 0
    sleep 0.2
    tries=$((tries + 1))
  done
  fail "the herdr server did not start. Check: herdr status"
}

# Print the id of the workspace with this label, or nothing.
workspace_id() {
  herdr workspace list 2>/dev/null |
    jq -r --arg label "$1" '[.result.workspaces[] | select(.label == $label) | .workspace_id][0] // empty'
}

# Create the workspace when it does not exist, then focus it and attach.
open_workspace() {
  dir=$1
  [ -d "$dir" ] || fail "folder not found: $dir"
  name=$(printf '%s' "${dir##*/}" | tr ' .:/' '----')
  require_herdr
  ensure_server
  id=$(workspace_id "$name")
  if [ -z "$id" ]; then
    created=$(herdr workspace create --cwd "$dir" --label "$name" --no-focus)
    id=$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id')
    left=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id')
    right=$(herdr pane split "$left" --direction right --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')
    herdr pane run "$right" "$REPO/bin/eww-context" >/dev/null
    step "starting $AGENT in $name"
    # The agent starts in the background so attaching is not delayed. herdr
    # refuses while the new pane's shell is still starting, so retry that case.
    # On failure the pane stays at its shell, which is the visible signal.
    (
      tries=0
      while [ "$tries" -lt 50 ]; do
        if output=$(herdr agent start "$name" --kind "$AGENT" --pane "$left" 2>&1); then
          break
        fi
        case $output in
          *agent_pane_busy*) ;;
          *) break ;;
        esac
        tries=$((tries + 1))
        sleep 0.2
      done
    ) >/dev/null 2>&1 &
  fi
  herdr workspace focus "$id" >/dev/null
  if [ -n "${HERDR_PANE_ID:-}" ]; then
    # Already inside herdr, which refuses to nest. Focusing is enough.
    ok "workspace \"$name\" focused"
    return 0
  fi
  status=0
  herdr || status=$?
  # herdr resets the cursor on detach. Put the steady block cursor back.
  if [ -t 1 ]; then printf '\033[2 q'; fi
  exit "$status"
}

stop_server() {
  command -v herdr >/dev/null 2>&1 || fail "herdr is not installed"
  if ! server_running; then
    ok "the herdr server is not running"
    return 0
  fi
  if [ -n "${HERDR_PANE_ID:-}" ]; then
    warn "stopping the server ends this herdr session too"
  fi
  herdr server stop >/dev/null 2>&1 || true
  ok "herdr server stopped"
}

case ${1:-} in
  stop)
    stop_server
    ;;
  -*)
    printf '%s✗%s eww h: unknown option "%s"\n' "$red" "$reset" "$1" >&2
    exit 2
    ;;
  *)
    if [ $# -gt 1 ]; then
      printf '%s✗%s eww h: too many arguments\n' "$red" "$reset" >&2
      exit 2
    fi
    chosen=$(target_dir "${1:-}")
    [ -n "$chosen" ] || exit 0
    open_workspace "$chosen"
    ;;
esac
