#!/usr/bin/env -S uv run --quiet --script
# eww: capture | Write an eight-part lesson note for a term, with a diagram.
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""eww course [--dry-run] TERM

Write a short lesson on TERM into the primary vault, at
collections/lesson/TERM.md. The lesson has eight headed parts: why it matters,
what you need first, the mechanism with one Mermaid diagram, how it works, a
worked example, variations, limits and common mistakes, and a question to try.

When collections/definition/TERM.md exists, its text is given to the agent, so
the lesson extends that definition and agrees with it.

The text comes from one headless agent call with no tools and no web access.
No sources are checked, and the note says so. The reply is checked for shape
before anything is written. An existing note is never replaced. When the model
does not know the term, nothing is written.

  --dry-run   print the note without writing it

Settings:
  EWW_COURSE_COMMAND   the agent command to run. It reads the prompt on
                       standard input and prints the reply. The default is
                       claude in print mode with every tool turned off.
"""
from __future__ import annotations

import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

DEFAULT_COMMAND = [
    "claude", "--print", "--tools", "", "--strict-mcp-config",
    "--disable-slash-commands", "--no-session-persistence",
]
SECTIONS = (
    "Why it matters",
    "What you need first",
    "The mechanism",
    "How it works",
    "Worked example",
    "Variations",
    "Limits and common mistakes",
    "Try it",
)
DIAGRAM_SECTION = "The mechanism"
QUESTION_SECTION = "Try it"
MOST_DIAGRAM_NODES = 10
SHORTEST_SECTION_WORDS = 30
LONGEST_SECTION_WORDS = 130
AGENT_TIMEOUT_SECONDS = 300
NO_SOURCES_LINE = "Written from model memory by `eww course`. No sources were checked."

PROMPT = """Teach the term below to a reader who is smart but new to it. Write a short first lesson.

Reply with exactly this shape and nothing else. No title, no preamble, no closing remark.
Use these eight headings, in this order, each written as a level-two Markdown heading:

## Why it matters
The problem this idea solves, and what goes wrong without it.

## What you need first
The one or two earlier ideas the reader must accept, each defined in a sentence.

## The mechanism
What acts on what, and what changes as a result. After the paragraph, add one diagram of that mechanism:

```mermaid
flowchart TD
  (at most 8 nodes, node labels of 1 to 3 words, no styling)
```

## How it works
The steps in order. Say why each step follows from the one before.

## Worked example
One concrete case, with numbers where they help. Say that invented values are invented.

## Variations
The main forms of the idea, and what separates them.

## Limits and common mistakes
When the idea does not apply, and one common confusion with how to tell the two things apart.

## Try it
One question that asks the reader to predict or apply. Then a new paragraph that starts with **Answer.** and gives the answer.

Rules:
- Each part is 60 to 100 words of plain prose. Short sentences. No idioms. Never use an em-dash.
- Define every term before relying on it. Each part must build on the part before it.
- The diagram must show the same mechanism its paragraph states.
- Do not cite sources, and do not state a number, date, or name you are not sure of.
- If the term has several meanings, teach the one most used in data science, software, or systems thinking, and name the field in the first part.
- If you do not know the term, or it is not a real term, reply with one line only: UNKNOWN: followed by a short reason.
{definition}
Term: {term}
"""

DEFINITION_PROMPT = """
The reader already has the definition note below. Agree with it. Go further than it, and do not repeat it.

<definition>
{text}
</definition>
"""


class RejectedReply(Exception):
    """The agent's reply does not have the required shape."""


class UnknownTerm(Exception):
    """The agent said it does not know the term."""


def vault_path(home: Path) -> Path | None:
    """The primary vault: the first line of ~/.config/eww/vault, or None when the file is absent."""
    pointer = home / ".config" / "eww" / "vault"
    if not pointer.is_file():
        return None
    lines = [line.strip() for line in pointer.read_text().splitlines() if line.strip()]
    if not lines:
        return None
    return home / lines[0][2:] if lines[0].startswith("~/") else Path(lines[0])


def note_title(term: str) -> str:
    """The term as a note title: trimmed, with a capital first letter and no path characters."""
    title = " ".join(term.split())
    title = re.sub(r'[\\/:*?"<>|#^\[\]]', "", title).strip(" .")
    return title[:1].upper() + title[1:]


def existing_note(folder: Path, title: str) -> Path | None:
    """A note in the folder with this title, ignoring case, or None."""
    if not folder.is_dir():
        return None
    for path in folder.glob("*.md"):
        if path.stem.lower() == title.lower():
            return path
    return None


def definition_text(vault: Path, title: str) -> str | None:
    """The body of the definition note for this title, without its title and tag lines, or None."""
    note = existing_note(vault / "collections" / "definition", title)
    if note is None:
        return None
    lines = note.read_text().splitlines()
    kept = [line for line in lines if not line.startswith("# ") and line.strip() != "#llm-generated"]
    return "\n".join(kept).strip() or None


def build_prompt(term: str, definition: str | None) -> str:
    """The prompt for one term, with the existing definition included when there is one."""
    extra = DEFINITION_PROMPT.format(text=definition) if definition else ""
    return PROMPT.format(term=term, definition=extra)


def diagram_nodes(diagram: str) -> set[str]:
    """Ids of the nodes a Mermaid flowchart declares with a label, such as A[Label]."""
    return set(re.findall(r"\b([A-Za-z_][\w]*)\s*(?:\[|\(|\{)", diagram))


def lesson_sections(body: str) -> list[tuple[str, str]]:
    """The level-two sections of a lesson, in order, as (heading, text) pairs."""
    parts = re.split(r"^## +(.+?) *$", body, flags=re.M)
    return [(parts[index].strip(), parts[index + 1].strip()) for index in range(1, len(parts), 2)]


def checked_body(reply: str) -> str:
    """The reply, cleaned and confirmed to have the required shape. Raises when it does not."""
    body = reply.strip()
    unknown = re.match(r"UNKNOWN:\s*(.*)", body)
    if unknown:
        raise UnknownTerm(unknown.group(1).strip() or "no reason given")
    if not body.startswith(f"## {SECTIONS[0]}"):
        raise RejectedReply(f'the reply does not start with the "{SECTIONS[0]}" heading')
    if "—" in body:
        body = body.replace(" — ", ", ").replace("—", ", ")
    sections = lesson_sections(body)
    headings = [heading for heading, _ in sections]
    if headings != list(SECTIONS):
        raise RejectedReply(f"the headings are wrong: expected {len(SECTIONS)} in the set order, got {headings}")
    for heading, text in sections:
        diagrams = re.findall(r"^```mermaid\n(.*?)\n```", text, re.S | re.M)
        if heading == DIAGRAM_SECTION:
            if len(diagrams) != 1:
                raise RejectedReply(f'"{heading}" must hold exactly one Mermaid diagram')
            if not diagrams[0].lstrip().startswith("flowchart TD"):
                raise RejectedReply("the diagram is not a top-down flowchart")
            nodes = diagram_nodes(diagrams[0])
            if not nodes:
                raise RejectedReply("the diagram declares no labelled nodes")
            if len(nodes) > MOST_DIAGRAM_NODES:
                raise RejectedReply(f"the diagram has {len(nodes)} nodes, more than {MOST_DIAGRAM_NODES}")
        elif "```" in text:
            raise RejectedReply(f'"{heading}" holds a code block or a second diagram')
        words = len(re.sub(r"^```.*?^```", "", text, flags=re.S | re.M).split())
        if words < SHORTEST_SECTION_WORDS:
            raise RejectedReply(f'"{heading}" is too short: {words} words')
        if words > LONGEST_SECTION_WORDS:
            raise RejectedReply(f'"{heading}" is too long: {words} words')
        if heading == QUESTION_SECTION and not re.search(r"^\*\*Answer\.\*\*", text, re.M):
            raise RejectedReply(f'"{heading}" has no paragraph that starts with **Answer.**')
    return body


def render_note(title: str, body: str) -> str:
    """The full note: title, the machine-written mark, the no-sources line, then the checked body."""
    return f"# {title}\n#llm-generated\n\n{NO_SOURCES_LINE}\n\n{body}\n"


def agent_command() -> list[str]:
    custom = os.environ.get("EWW_COURSE_COMMAND")
    return shlex.split(custom) if custom else DEFAULT_COMMAND


def ask_agent(prompt: str, command: list[str]) -> str:
    """Run the agent once with the prompt on standard input, and return its reply."""
    result = subprocess.run(command, input=prompt, capture_output=True, text=True, timeout=AGENT_TIMEOUT_SECONDS)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().splitlines()
        raise RuntimeError(detail[-1] if detail else f"exit code {result.returncode}")
    return result.stdout


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    dry_run = "--dry-run" in argv
    words = [argument for argument in argv if argument != "--dry-run"]
    unknown_options = [word for word in words if word.startswith("-")]
    if unknown_options:
        print(f'✗ eww course: unknown option "{unknown_options[0]}"', file=sys.stderr)
        return 2
    title = note_title(" ".join(words))
    if not title:
        print("✗ eww course: give a term to teach", file=sys.stderr)
        return 2

    vault = vault_path(Path(os.environ.get("EWW_HOME") or Path.home()))
    if vault is None or not vault.is_dir():
        print("✗ eww course: no vault on this machine: ~/.config/eww/vault is missing or wrong", file=sys.stderr)
        return 1
    folder = vault / "collections" / "lesson"
    existing = existing_note(folder, title)
    if existing:
        print(f"✓ a note already exists: {existing.relative_to(vault).as_posix()}")
        return 0

    definition = definition_text(vault, title)
    command = agent_command()
    basis = "extending its definition note" if definition else "with no definition note to extend"
    print(f"→ asking {command[0]} for a lesson on {title}, {basis}", file=sys.stderr)
    try:
        body = checked_body(ask_agent(build_prompt(title, definition), command))
    except UnknownTerm as error:
        print(f"! eww course: the model does not know this term: {error}", file=sys.stderr)
        return 1
    except RejectedReply as error:
        print(f"✗ eww course: the reply was rejected: {error}. Nothing was written. Run it again.", file=sys.stderr)
        return 1
    except FileNotFoundError:
        print(f"✗ eww course: {command[0]} is not installed", file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired:
        print(f"✗ eww course: {command[0]} did not answer in {AGENT_TIMEOUT_SECONDS} seconds", file=sys.stderr)
        return 1
    except RuntimeError as error:
        print(f"✗ eww course: {command[0]} failed: {error}", file=sys.stderr)
        return 1

    note = render_note(title, body)
    if dry_run:
        print(note, end="")
        return 0
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"{title}.md"
    # "x" refuses to write over a file that appeared since the check above.
    with path.open("x") as handle:
        handle.write(note)
    print(f"✓ wrote {path.relative_to(vault).as_posix()}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
