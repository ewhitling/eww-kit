#!/bin/sh
# eww: the launcher. It holds no logic of its own.
# `eww <verb>` runs a standalone program named `eww-<verb>`.
# Bare `eww` prints the map of every such program it can find.
set -eu

# Find the repo this script lives in, following symlinks.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
REPO=$(cd "$(dirname "$self")/.." && pwd -P)
VERSION=$(cat "$REPO/VERSION" 2>/dev/null || echo unknown)

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ -z "${EWW_NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
  bold=$(printf '\033[1m') dim=$(printf '\033[2m') red=$(printf '\033[31m')
  accent=$(printf '\033[34m') reset=$(printf '\033[0m')
  # The verb gradient needs 24-bit color. Other terminals get the plain accent.
  case ${COLORTERM:-} in
    truecolor | 24bit) gradient=1 ;;
    *) gradient='' ;;
  esac
else
  bold='' dim='' red='' accent='' reset='' gradient=''
fi

# Print one line per program: "group<TAB>verb<TAB>summary".
# A program describes itself with a comment line: "# eww: <group> | <summary>".
list_programs() {
  seen=' '
  old_ifs=$IFS
  IFS=:
  for dir in "$REPO/bin" $PATH; do
    IFS=$old_ifs
    [ -d "$dir" ] || continue
    for program in "$dir"/eww-*; do
      [ -f "$program" ] && [ -x "$program" ] || continue
      verb=${program##*/eww-}
      case $seen in *" $verb "*) continue ;; esac
      seen="$seen$verb "
      # A symlink to a differently named program is an alias. Leave it off the map.
      if [ -L "$program" ]; then
        target=$(readlink "$program")
        [ "${target##*/}" = "eww-$verb" ] || continue
      fi
      meta=$(sed -n 's/^# eww: //p' "$program" 2>/dev/null | head -n 1)
      if [ -n "$meta" ]; then
        group=$(printf '%s' "$meta" | cut -d'|' -f1 | tr -d ' ')
        summary=$(printf '%s' "$meta" | cut -d'|' -f2- | sed 's/^ *//')
      else
        group=other summary=''
      fi
      printf '%s\t%s\t%s\n' "$group" "$verb" "$summary"
    done
  done
  IFS=$old_ifs
}

# The color for verb number $1 of $2: a blue to purple gradient in 24-bit color.
# Three anchors: deep blue, light blue-purple, deep purple. All stay bright
# enough to read on a dark background.
gradient_color() {
  step=0
  [ "$2" -gt 1 ] && step=$(($1 * 15 / ($2 - 1)))
  if [ "$step" -le 7 ]; then
    r=$((70 + 95 * step / 7)) g=$((120 + 30 * step / 7)) b=250
  else
    step=$((step - 7))
    r=$((165 + 10 * step / 8)) g=$((150 - 70 * step / 8)) b=$((250 - 30 * step / 8))
  fi
  printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
}

print_map() {
  tab=$(printf '\t')
  programs=$(list_programs)
  ordered=$(
    for group in place work capture other; do
      printf '%s\n' "$programs" | awk -F'\t' -v g="$group" '$1 == g' | sort -t"$tab" -k2
    done
  )
  total=$(printf '%s\n' "$ordered" | grep -c . || true)
  printf '%seww %s%s  mise-en-place for deep work\n' "$bold" "$VERSION" "$reset"
  index=0
  shown=''
  printf '%s\n' "$ordered" | while IFS="$tab" read -r group verb summary; do
    [ -n "$verb" ] || continue
    if [ "$group" != "$shown" ]; then
      printf '\n%s─ %s ─────────────────────────────%s\n' "$dim" "$group" "$reset"
      shown=$group
    fi
    color=$accent
    [ -n "$gradient" ] && color=$(gradient_color "$index" "$total")
    printf '  %s%-11s%s %s\n' "$color" "$verb" "$reset" "$summary"
    index=$((index + 1))
  done
  printf '\n%seww help <verb> for detail%s\n' "$dim" "$reset"
}

find_program() {
  if [ -x "$REPO/bin/eww-$1" ]; then
    printf '%s\n' "$REPO/bin/eww-$1"
  else
    command -v "eww-$1" 2>/dev/null || true
  fi
}

run_verb() {
  verb=$1
  shift
  program=$(find_program "$verb")
  if [ -z "$program" ]; then
    printf '%s✗ eww: unknown command "%s"%s\n\n' "$red" "$verb" "$reset" >&2
    print_map >&2
    exit 1
  fi
  exec "$program" "$@"
}

case ${1:-help} in
  help | -h | --help)
    if [ $# -ge 2 ]; then
      run_verb "$2" --help
    fi
    print_map
    ;;
  version | -v | --version)
    printf 'eww %s\n' "$VERSION"
    ;;
  *)
    run_verb "$@"
    ;;
esac
